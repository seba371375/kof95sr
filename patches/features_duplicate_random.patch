+static void io_draw_text(uint32_t *fb, int x, int y, const char *str, uint32_t color) {
+    if (!fb || !str) return;
+    int cur_x = x;
+    while (*str) {
+        char c = *str++;
+        if (c < 32 || c > 126) c = ' ';
+        const uint8_t *glyph = font_8x8[c - 32];
+        for (int row = 0; row < 8; row++) {
+            int py = y + row;
+            if (py < 0 || py >= NG_SCREEN_H) continue;
+            uint8_t bits = glyph[row];
+            for (int col = 0; col < 8; col++) {
+                int px = cur_x + col;
+                if (px < 0 || px >= NG_SCREEN_W) continue;
+                if ((bits >> (7 - col)) & 1) {
+                    if (px + 1 < NG_SCREEN_W && py + 1 < NG_SCREEN_H) {
+                        fb[(py + 1) * NG_SCREEN_W + (px + 1)] = 0xFF000000;
+                    }
+                    fb[py * NG_SCREEN_W + px] = color;
+                }
+            }
+        }
+        cur_x += 8;
+    }
+}
+
+void io_post_render_frame(uint32_t *fb) {
+    if (!fb || !s_random_select) return;
+
+    uint8_t *w = bus_wram();
+    if (!w) return;
+
+    int p1_task_off = io_find_select_task(w, 0);
+    int p2_task_off = io_find_select_task(w, 1);
+
+    bool selecting = (p1_task_off >= 0 && w[0xA842] < 3) ||
+                     (p2_task_off >= 0 && w[0xA852] < 3);
+    if (!selecting) {
+        s_p1_on_random = false;
+        s_p2_on_random = false;
+        return;
+    }
+
+    // Buffer clean character cards for King (x=80..111, y=88..125) and Iori (x=208..239, y=88..125)
+    static uint32_t s_king_clean[34 * 39];
+    static uint32_t s_iori_clean[34 * 39];
+    static bool s_has_king_clean = false;
+    static bool s_has_iori_clean = false;
+
+    uint8_t p1_char = w[0xA843 + (w[0xA842] < 3 ? w[0xA842] : 2)];
+    if (!s_p1_on_random && !s_p2_on_random) {
+        if (p1_char != 23) {
+            for (int y = 0; y < 39; y++) {
+                for (int x = 0; x < 34; x++) {
+                    s_king_clean[y * 34 + x] = fb[(88 + y) * NG_SCREEN_W + (79 + x)];
+                }
+            }
+            s_has_king_clean = true;
+        }
+        if (p1_char != 9) {
+            for (int y = 0; y < 39; y++) {
+                for (int x = 0; x < 34; x++) {
+                    s_iori_clean[y * 34 + x] = fb[(88 + y) * NG_SCREEN_W + (207 + x)];
+                }
+            }
+            s_has_iori_clean = true;
+        }
+    }
+
+    // Restore pristine King or Iori portrait when player is on (?)
+    if (s_p1_on_random) {
+        if (s_p1_random_col == 3 && s_has_king_clean) {
+            for (int y = 0; y < 39; y++) {
+                for (int x = 0; x < 34; x++) {
+                    fb[(88 + y) * NG_SCREEN_W + (79 + x)] = s_king_clean[y * 34 + x];
+                }
+            }
+        } else if (s_p1_random_col == 5 && s_has_iori_clean) {
+            for (int y = 0; y < 39; y++) {
+                for (int x = 0; x < 34; x++) {
+                    fb[(88 + y) * NG_SCREEN_W + (207 + x)] = s_iori_clean[y * 34 + x];
+                }
+            }
+        }
+        // Character name bar for P1
+        for (int y = 137; y < 147; y++) {
+            for (int x = 16; x < 144; x++) {
+                fb[y * NG_SCREEN_W + x] = 0xFF755524;
+            }
+        }
+        io_draw_text(fb, 16, 138, "RANDOM SELECT", 0xFFFFD700);
+    }
+
+    if (s_p2_on_random) {
+        if (s_p2_random_col == 3 && s_has_king_clean) {
+            for (int y = 0; y < 39; y++) {
+                for (int x = 0; x < 34; x++) {
+                    fb[(88 + y) * NG_SCREEN_W + (79 + x)] = s_king_clean[y * 34 + x];
+                }
+            }
+        } else if (s_p2_random_col == 5 && s_has_iori_clean) {
+            for (int y = 0; y < 39; y++) {
+                for (int x = 0; x < 34; x++) {
+                    fb[(88 + y) * NG_SCREEN_W + (207 + x)] = s_iori_clean[y * 34 + x];
+                }
+            }
+        }
+        // Character name bar for P2
+        for (int y = 137; y < 147; y++) {
+            for (int x = 176; x < 304; x++) {
+                fb[y * NG_SCREEN_W + x] = 0xFF755524;
+            }
+        }
+        io_draw_text(fb, 176, 138, "RANDOM SELECT", 0xFFFFD700);
+    }
+
+    // Row 2 gap slots:
+    // Slot 3: x = 112, y = 96, w = 32, h = 30 (next to King)
+    // Slot 5: x = 176, y = 96, w = 32, h = 30 (next to Iori)
+    bool p1_on_col3 = s_p1_on_random && (s_p1_random_col == 3);
+    bool p1_on_col5 = s_p1_on_random && (s_p1_random_col == 5);
+    bool p2_on_col3 = s_p2_on_random && (s_p2_random_col == 3);
+    bool p2_on_col5 = s_p2_on_random && (s_p2_random_col == 5);
+
+    draw_random_card(fb, 112, 96, 32, 30, p1_on_col3, p2_on_col3);
+    draw_random_card(fb, 176, 96, 32, 30, p1_on_col5, p2_on_col5);
+}
+
+void io_on_order_select(void) {
+    if (!s_need_stage_reroll) return;
+    s_need_stage_reroll = false;
+
+    uint8_t *w = bus_wram();
+    if (!w) return;
+
+    bool p1_has_rnd = s_p1_random_slots[0] || s_p1_random_slots[1] || s_p1_random_slots[2];
+    bool p2_has_rnd = s_p2_random_slots[0] || s_p2_random_slots[1] || s_p2_random_slots[2];
+
+    if (!p1_has_rnd && !p2_has_rnd) return;
+
+    printf("[RANDOM RE-ROLL] Match concluded! Re-rolling random fighter slots...\n");
+
+    if (p1_has_rnd) {
+        uint8_t temp[3] = { w[0xA843], w[0xA844], w[0xA845] };
+        for (int s = 0; s < 3; s++) {
+            if (s_p1_random_slots[s]) temp[s] = 0xFF;
+        }
+        for (int s = 0; s < 3; s++) {
+            if (s_p1_random_slots[s]) {
+                uint8_t new_char = roll_random_char_for_team(temp, s);
+                temp[s] = new_char;
+                w[0xA843 + s] = new_char;
+                printf("[RANDOM RE-ROLL] P1 Slot %d -> %s (ID %d)\n",
+                       s + 1, s_fighter_names[new_char], new_char);
+            }
+        }
+    }
+
+    if (p2_has_rnd) {
+        uint8_t temp[3] = { w[0xA853], w[0xA854], w[0xA855] };
+        for (int s = 0; s < 3; s++) {
+            if (s_p2_random_slots[s]) temp[s] = 0xFF;
+        }
+        for (int s = 0; s < 3; s++) {
+            if (s_p2_random_slots[s]) {
+                uint8_t new_char = roll_random_char_for_team(temp, s);
+                temp[s] = new_char;
+                w[0xA853 + s] = new_char;
+                printf("[RANDOM RE-ROLL] P2 Slot %d -> %s (ID %d)\n",
+                       s + 1, s_fighter_names[new_char], new_char);
+            }
+        }
+    }
+}
+
+void io_on_audio_command(uint8_t cmd) {
+    // 0x30 = "Spring of this World" (Victory Demo screen BGM)
+    // 0x28 = "Vortex of Ambition" (Game Over / Continue BGM)
+    if (cmd == 0x30 || cmd == 0x28) {
+        bool has_rnd = s_p1_random_slots[0] || s_p1_random_slots[1] || s_p1_random_slots[2] ||
+                       s_p2_random_slots[0] || s_p2_random_slots[1] || s_p2_random_slots[2];
+        if (has_rnd) {
+            s_need_stage_reroll = true;
+            printf("[RANDOM SELECT] Match finished (sound cmd 0x%02X). Random slots will re-roll at next Order Select.\n", cmd);
+        }
     }
 }
 
