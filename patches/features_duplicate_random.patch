+/* ---- 3. Post-Render Frame: Draw (?) Icon on Character Select Screen ---- */
+static void draw_random_card(uint32_t *fb, int rx, int ry, int rw, int rh, bool p1_hover, bool p2_hover) {
+    if (!fb) return;
+
+    // 1. Crisp white/silver arcade card frame border (1px)
+    for (int y = ry; y < ry + rh; y++) {
+        if (y < 0 || y >= NG_SCREEN_H) continue;
+        for (int x = rx; x < rx + rw; x++) {
+            if (x < 0 || x >= NG_SCREEN_W) continue;
+            if (x == rx || x == rx + rw - 1 || y == ry || y == ry + rh - 1) {
+                fb[y * NG_SCREEN_W + x] = 0xFFFFFFFF; // Pure white outer border
+            } else if (x == rx + 1 || y == ry + 1) {
+                fb[y * NG_SCREEN_W + x] = 0xFF2A3D66; // Top-left inner highlight
+            } else if (x == rx + rw - 2 || y == ry + rh - 2) {
+                fb[y * NG_SCREEN_W + x] = 0xFF050810; // Bottom-right inner shadow
+            } else {
+                int rel_y = y - ry;
+                uint32_t bg = (rel_y < rh / 3) ? 0xFF141E34 :
+                              (rel_y < 2 * rh / 3) ? 0xFF0E1526 : 0xFF080D1A;
+                fb[y * NG_SCREEN_W + x] = bg;
+            }
+        }
+    }
+
+    // 2. Arcade gold '?' glyph with 3D shadow (12x16)
+    static const uint16_t s_qm_glyph[16] = {
+        0x03C0, //      ####
+        0x07E0, //     ######
+        0x0E70, //    ###  ###
+        0x0E70, //    ###  ###
+        0x0070, //         ###
+        0x00E0, //        ###
+        0x01C0, //       ###
+        0x0380, //      ###
+        0x0300, //      ##
+        0x0300, //      ##
+        0x0000, //
+        0x0000, //
+        0x0300, //      ##
+        0x0380, //      ###
+        0x0380, //      ###
+        0x0000
+    };
+
+    const int gx = rx + (rw - 12) / 2;
+    const int gy = ry + (rh - 16) / 2;
+    for (int r = 0; r < 16; r++) {
+        int py = gy + r;
+        if (py < 0 || py >= NG_SCREEN_H) continue;
+        uint16_t row = s_qm_glyph[r];
+        for (int c = 0; c < 12; c++) {
+            int px = gx + c;
+            if (px < 0 || px >= NG_SCREEN_W) continue;
+            if ((row >> (11 - c)) & 1) {
+                if (px + 1 < rx + rw - 1 && py + 1 < ry + rh - 1) {
+                    fb[(py + 1) * NG_SCREEN_W + (px + 1)] = 0xFF020408;
+                }
+                uint32_t col = (r < 4) ? 0xFFFFF176 :
+                               (r < 9) ? 0xFFFFD700 :
+                               (r < 12) ? 0xFFFFB300 : 0xFFFFC107;
+                fb[py * NG_SCREEN_W + px] = col;
+            }
+        }
+    }
+
+    // 3. Pixel-perfect 1P cursor bracket & "1P" tag
+    if (p1_hover) {
+        uint32_t col = 0xFF00B0FF; // Cyan / Arcade 1P Blue
+        // Top-left L-bracket
+        for (int i = 0; i < 7; i++) {
+            if (rx - 1 + i < NG_SCREEN_W) {
+                fb[(ry - 1) * NG_SCREEN_W + (rx - 1 + i)] = col;
+                fb[ry * NG_SCREEN_W + (rx - 1 + i)] = col;
+            }
+            if (ry - 1 + i < NG_SCREEN_H) {
+                fb[(ry - 1 + i) * NG_SCREEN_W + (rx - 1)] = col;
+                fb[(ry - 1 + i) * NG_SCREEN_W + rx] = col;
+            }
+        }
+        // Bottom-right L-bracket
+        for (int i = 0; i < 7; i++) {
+            if (rx + rw - 6 + i < NG_SCREEN_W) {
+                fb[(ry + rh - 1) * NG_SCREEN_W + (rx + rw - 6 + i)] = col;
+                fb[(ry + rh) * NG_SCREEN_W + (rx + rw - 6 + i)] = col;
+            }
+            if (ry + rh - 6 + i < NG_SCREEN_H) {
+                fb[(ry + rh - 6 + i) * NG_SCREEN_W + (rx + rw - 1)] = col;
+                fb[(ry + rh - 6 + i) * NG_SCREEN_W + (rx + rw)] = col;
+            }
+        }
+    }
+
+    // 4. Pixel-perfect 2P cursor bracket
+    if (p2_hover) {
+        uint32_t col = 0xFFFF3333; // Arcade 2P Red
+        // Top-right L-bracket
+        for (int i = 0; i < 7; i++) {
+            if (rx + rw - 6 + i < NG_SCREEN_W) {
+                fb[(ry - 1) * NG_SCREEN_W + (rx + rw - 6 + i)] = col;
+                fb[ry * NG_SCREEN_W + (rx + rw - 6 + i)] = col;
+            }
+            if (ry - 1 + i < NG_SCREEN_H) {
+                fb[(ry - 1 + i) * NG_SCREEN_W + (rx + rw - 1)] = col;
+                fb[(ry - 1 + i) * NG_SCREEN_W + (rx + rw)] = col;
+            }
+        }
+        // Bottom-left L-bracket
+        for (int i = 0; i < 7; i++) {
+            if (rx - 1 + i < NG_SCREEN_W) {
+                fb[(ry + rh - 1) * NG_SCREEN_W + (rx - 1 + i)] = col;
+                fb[(ry + rh) * NG_SCREEN_W + (rx - 1 + i)] = col;
+            }
+            if (ry + rh - 6 + i < NG_SCREEN_H) {
+                fb[(ry + rh - 6 + i) * NG_SCREEN_W + (rx - 1)] = col;
+                fb[(ry + rh - 6 + i) * NG_SCREEN_W + rx] = col;
+            }
+        }
+    }
+}
