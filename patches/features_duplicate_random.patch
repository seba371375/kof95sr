+static int io_find_select_task(const uint8_t *w, int player) {
+    if (!w) return -1;
+    for (int off = 0x500; off <= 0x900; off += 0x100) {
+        uint32_t pc = ((uint32_t)w[off] << 24) | ((uint32_t)w[off+1] << 16) |
+                      ((uint32_t)w[off+2] << 8) | (uint32_t)w[off+3];
+        bool is_sel = (pc >= 0x0003E600 && pc <= 0x0003ECDA && pc != 0x0003EB50);
+        if (is_sel && w[off + 0x130] == player) {
+            return off;
+        }
+    }
+    return -1;
+}
