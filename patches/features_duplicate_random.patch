+static uint8_t roll_random_char(const uint8_t *existing_slots, int num_existing) {
+    extern int64_t ng_frame_start;
+    static bool s_seeded = false;
+    if (!s_seeded) {
+        srand((unsigned int)time(NULL));
+        s_seeded = true;
+    }
+
+    uint32_t entropy = (uint32_t)(rand() ^ (ng_frame_start & 0xFFFFFFFF));
+    uint8_t rnd = (uint8_t)(entropy % 24);
+    if (!s_allow_duplicates && num_existing > 0 && existing_slots != NULL) {
+        for (int attempt = 0; attempt < 100; attempt++) {
+            bool dup = false;
+            for (int i = 0; i < num_existing; i++) {
+                if (existing_slots[i] == rnd) {
+                    dup = true;
+                    break;
+                }
+            }
+            if (!dup) break;
+            entropy = (uint32_t)(rand() ^ ((ng_frame_start + (int64_t)(attempt * 31 + 7)) & 0xFFFFFFFF));
+            rnd = (uint8_t)(entropy % 24);
+        }
+    }
+    return rnd;
+}
+
+static uint8_t roll_random_char_for_team(const uint8_t *team, int slot_to_roll) {
+    extern int64_t ng_frame_start;
+    static bool s_seeded = false;
+    if (!s_seeded) {
+        srand((unsigned int)time(NULL));
+        s_seeded = true;
+    }
+
+    uint32_t entropy = (uint32_t)(rand() ^ (ng_frame_start & 0xFFFFFFFF));
+    uint8_t rnd = (uint8_t)(entropy % 24);
+    if (!s_allow_duplicates) {
+        for (int attempt = 0; attempt < 100; attempt++) {
+            bool dup = false;
+            for (int i = 0; i < 3; i++) {
+                if (i != slot_to_roll && team[i] == rnd) {
+                    dup = true;
+                    break;
+                }
+            }
+            if (!dup) break;
+            entropy = (uint32_t)(rand() ^ ((ng_frame_start + (int64_t)(attempt * 31 + 7)) & 0xFFFFFFFF));
+            rnd = (uint8_t)(entropy % 24);
+        }
+    }
+    return rnd;
+}
 
